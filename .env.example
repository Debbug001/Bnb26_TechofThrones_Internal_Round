# Roundtable Backend Configuration
PORT=5000
# One URL, or several separated by commas. Only enforced when NODE_ENV=production.
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Supabase PostgreSQL Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit Real-Time Audio Room Configuration
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Roundtable Frontend Configuration (Vite)
# Leave EMPTY in development: Vite proxies /api to the backend. Set only if the backend is on another public address.
VITE_API_URL=
